  "region_priority_fallback_regex": "台湾|台灣|taiwan|(?:^|[^a-z])tw(?:[^a-z]|$)",
  "region_priority_test_url": "https://cp.cloudflare.com/generate_204",
  "region_priority_urltest_interval_seconds": 300,
  "region_priority_urltest_tolerance_ms": 30,
  "region_priority_fallback_interval_seconds": 60,
  "region_priority_health_timeout_ms": 5000,
  "region_priority_max_failed_times": 2,
  "poll_seconds": 2,
  "stabilize_seconds": 3,
  "auto_node_debounce_seconds": 10,
  "auto_node_debounce_max_rounds": 3,
