{
  "strategy_version": "v2.2-region-priority",
  "enabled": true,
  "mihomo_process_name": "verge-mihomo.exe",
  "tun_adapter_name": "Meta",
  "mihomo_pipe": "\\\\.\\pipe\\verge-mihomo",
  "auto_group_name": "自动选择",
  "region_priority_enabled": false,
  "region_priority_primary_group": "新加坡自动",
  "region_priority_fallback_group": "台湾兜底",
